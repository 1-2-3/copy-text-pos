#include <windows.h>

1 ICON "../../assets/icon.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION 0,1,9,0
PRODUCTVERSION 0,1,9,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Copy Text Pos contributors"
      VALUE "FileDescription", "Copy Text Pos"
      VALUE "FileVersion", "0.1.9"
      VALUE "InternalName", "copy-text-pos"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "copy-text-pos.exe"
      VALUE "ProductName", "Copy Text Pos"
      VALUE "ProductVersion", "0.1.9"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
